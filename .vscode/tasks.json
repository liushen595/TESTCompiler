{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure active file",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE:STRING=Release",
                "-DCMAKE_SYSTEM_PROCESSOR:STRING=x64",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-B",
                "${workspaceFolder}/build/cmake-build",
                "-S",
                "${workspaceFolder}",
                "-G",
                "Ninja"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "cmake: debug TESTCompiler",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/cmake-build",
                "--config",
                "Debug",
                "--target",
                "TESTCompiler"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": []
